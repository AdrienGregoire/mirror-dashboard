<%!--
## EPITECH PROJECT, 2026
## index.html.heex
## File description:
## Admin template for listing and managing user accounts and roles
--%>

<div class="relative min-h-screen bg-slate-50 dark:bg-slate-900 overflow-hidden flex items-center justify-center p-4 sm:p-8">
  <div class="absolute top-10 -left-10 w-96 h-96 bg-purple-300 dark:bg-purple-900 rounded-full mix-blend-multiply filter blur-3xl opacity-70">
  </div>
  <div class="absolute top-20 -right-10 w-96 h-96 bg-blue-300 dark:bg-blue-900 rounded-full mix-blend-multiply filter blur-3xl opacity-70">
  </div>
  <div class="absolute -bottom-10 left-1/3 w-96 h-96 bg-pink-300 dark:bg-pink-900 rounded-full mix-blend-multiply filter blur-3xl opacity-70">
  </div>

  <div class="relative z-10 w-full max-w-4xl">
    <div class="glass-card p-8 sm:p-10 space-y-8">
      <div class="text-center">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-glass-gradient tracking-tight">
          Admin - Gestion des Utilisateurs
        </h1>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/20 dark:border-white/10 text-gray-800 dark:text-gray-200">
              <th scope="col" class="py-4 px-4 text-sm font-semibold">
                Email
              </th>
              <th scope="col" class="py-4 px-4 text-sm font-semibold">
                Rôle
              </th>
              <th scope="col" class="py-4 px-4 text-right text-sm font-semibold">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10 dark:divide-white/5">
            <tr
              :for={user <- @users}
              class="transition-colors hover:bg-white/10 dark:hover:bg-white/5"
            >
              <td class="whitespace-nowrap py-4 px-4 text-sm text-gray-900 dark:text-gray-100 font-medium">
                {user.email}
              </td>
              <td class="whitespace-nowrap py-4 px-4 text-sm">
                <span class={[
                  "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold backdrop-blur-md border",
                  (user.role == "admin" &&
                     "bg-purple-500/20 text-purple-700 dark:text-purple-300 border-purple-500/30") ||
                    "bg-blue-500/20 text-blue-700 dark:text-blue-300 border-blue-500/30"
                ]}>
                  {user.role}
                </span>
              </td>
              <td class="whitespace-nowrap py-4 px-4 text-right text-sm font-medium space-x-2">
                <span :if={user.role != "admin"}>
                  <.link
                    href={~p"/admin/users/#{user.id}/promote"}
                    method="patch"
                    class="glass-button text-xs py-1.5 px-3 text-primary"
                  >Promouvoir</.link>
                </span>
                <.link
                  href={~p"/admin/users/#{user.id}"}
                  method="delete"
                  data-confirm="Es-tu sûr de vouloir supprimer cet utilisateur ?"
                  class="glass-button text-xs py-1.5 px-3 text-error hover:bg-error/20"
                >Supprimer</.link>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
