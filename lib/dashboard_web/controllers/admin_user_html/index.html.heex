<%!--
## EPITECH PROJECT, 2026
## index.html.heex
## File description:
## Admin template for listing and managing user accounts and roles
--%>

<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-4xl mt-16 px-6">
    <h1 class="text-2xl font-bold mb-8 text-gray-900">Admin - Gestion des Utilisateurs</h1>

    <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 rounded-lg">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">
              Email
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Rôle
            </th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <tr :for={user <- @users}>
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-700">
              {user.email}
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
              <span class={[
                "inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset",
                (user.role == "admin" && "bg-purple-50 text-purple-700 ring-purple-700/10") ||
                  "bg-blue-50 text-blue-700 ring-blue-700/10"
              ]}>
                {user.role}
              </span>
            </td>
            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6 space-x-3">
              <span :if={user.role != "admin"}>
                <.link
                  href={~p"/admin/users/#{user.id}/promote"}
                  method="patch"
                  class="text-indigo-600 hover:text-indigo-900"
                >Promouvoir</.link>
              </span>
              <.link
                href={~p"/admin/users/#{user.id}"}
                method="delete"
                data-confirm="Es-tu sûr de vouloir supprimer cet utilisateur ?"
                class="text-red-600 hover:text-red-900"
              >Supprimer</.link>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</Layouts.app>
