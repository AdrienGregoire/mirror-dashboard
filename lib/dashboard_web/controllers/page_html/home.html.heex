<.glass_page flash={@flash}>
  <div class="glass-card p-12 text-center space-y-10">
    <div class="space-y-4">
      <h1 class="glass-title text-5xl leading-tight">Welcome to Dashboard</h1>
      <p class="glass-muted font-medium text-lg">Dashboard Sport</p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 pt-4">
      <.link href={~p"/login"} class="glass-button flex-1 text-primary text-lg">
        <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5 mr-2" /> log in
      </.link>
      <.link href={~p"/register"} class="glass-button flex-1 text-lg">
        <.icon name="hero-user-plus" class="w-5 h-5 mr-2" /> Sign in
      </.link>
    </div>
  </div>
</.glass_page>
