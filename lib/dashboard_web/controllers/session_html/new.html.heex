<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-md mt-16 px-6">
    <h1 class="text-2xl font-bold mb-8 text-gray-900">Log in</h1>

    <.form for={@form} id="login-form" action={~p"/login"} method="post">
      <.input field={@form[:email]} type="email" label="Email" required />
      <.input field={@form[:password]} type="password" label="Password" required />

      <button
        type="submit"
        class="mt-6 w-full rounded-lg bg-indigo-600 px-4 py-2 text-white font-semibold hover:bg-indigo-500 transition-colors"
      >
        Log in
      </button>
    </.form>

    <p class="mt-4 text-sm text-gray-600">
      No account yet?
      <.link href={~p"/register"} class="text-indigo-600 font-semibold">Sign up</.link>
    </p>
  </div>
</Layouts.app>
