<div class="relative min-h-screen bg-slate-50 dark:bg-slate-900 overflow-hidden flex items-center justify-center p-4 sm:p-8">
  <%!-- Sphères d'arrière-plan floutées --%>
  <div class="absolute top-10 -left-10 w-96 h-96 bg-purple-300 dark:bg-purple-900 rounded-full mix-blend-multiply filter blur-3xl opacity-70">
  </div>
  <div class="absolute top-20 -right-10 w-96 h-96 bg-blue-300 dark:bg-blue-900 rounded-full mix-blend-multiply filter blur-3xl opacity-70">
  </div>
  <div class="absolute -bottom-10 left-1/3 w-96 h-96 bg-pink-300 dark:bg-pink-900 rounded-full mix-blend-multiply filter blur-3xl opacity-70">
  </div>

  <%!-- passage en max-w-lg (comme la landing page) --%>
  <div class="relative z-10 w-full max-w-lg">
    <div class="glass-card p-10 sm:p-12 space-y-8">
      
      <%!-- En-tête --%>
      <div class="text-center space-y-2">
        <h1 class="text-4xl font-extrabold text-glass-gradient tracking-tight">
          Log in
        </h1>
        <p class="text-gray-600 dark:text-gray-300 font-medium text-base">
          Dashboard Sport
        </p>
      </div>

      <%!-- Formulaire --%>
      <.form for={@form} id="login-form" action={~p"/login"} method="post" class="space-y-6">
        <div class="space-y-2 text-left">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Email</label>
          <.input field={@form[:email]} type="email" required placeholder="nom@exemple.com" label={false} class="glass-input" />
        </div>

        <div class="space-y-2 text-left">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200">Password</label>
          <.input field={@form[:password]} type="password" required placeholder="••••••••" label={false} class="glass-input" />
        </div>

        <button
          type="submit"
          class="glass-button w-full text-primary font-semibold text-lg py-3 mt-4"
        >
          <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5 mr-2" /> Log in
        </button>
      </.form>

      <%!-- Lien Inscription --%>
      <p class="text-center text-sm text-gray-600 dark:text-gray-300">
        No account yet?
        <.link href={~p"/register"} class="text-primary font-semibold hover:underline ml-1">
          Sign up
        </.link>
      </p>

      <%!-- Divider & GitHub --%>
      <div class="pt-6 border-t border-white/40 dark:border-white/10">
        <.link
          href={~p"/auth/github"}
          class="glass-button w-full text-lg font-semibold"
        >
          Continue with GitHub
        </.link>
      </div>

    </div>
  </div>
</div>