<%!--
## EPITECH PROJECT, 2026
## new.html.heex
## File description:
## Login page
--%>

<.glass_page flash={@flash}>
  <.auth_card title="Log in" subtitle="Dashboard Sport">
    <.form for={@form} id="login-form" action={~p"/login"} method="post" class="space-y-6">
      <.auth_input
        field={@form[:email]}
        type="email"
        label="Email"
        placeholder="name@exemple.com"
        autocomplete="email"
        required
        autofocus
      />
      <.auth_input
        field={@form[:password]}
        type="password"
        label="Password"
        placeholder="••••••••"
        autocomplete="current-password"
        required
      />
      <button
        type="submit"
        class="glass-button w-full text-primary font-semibold text-lg py-3 mt-4"
      >
        <.icon name="hero-arrow-right-on-rectangle" class="w-5 h-5 mr-2" /> Log in
      </button>
    </.form>

    <.auth_divider>or</.auth_divider>
    <.oauth_button provider="github" label="Continue with GitHub" />

    <:footer>
      No account yet?
      <.link href={~p"/register"} class="text-primary font-semibold hover:underline ml-1">
        Sign up
      </.link>
    </:footer>
  </.auth_card>
</.glass_page>
