<.glass_page max_w="max-w-3xl">
  <div class="glass-card p-10 sm:p-12 space-y-8 text-left">
    <div class="text-center space-y-2 mb-8">
      <h1 class="glass-title text-4xl">{gettext("Privacy Policy")}</h1>
    </div>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">{gettext("Who are we?")}</h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "Dashboard is a school project developed by two third-year Epitech students, Adrien and Marc-Antoine. It is not a commercial product."
        )}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("Why should you read this statement and what does it cover?")}
      </h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "This statement explains what personal data Dashboard collects, why we use it, and what rights you have over it. It applies to everything you do on the application."
        )}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("What personal data do we collect?")}
      </h2>
      <ul class="list-disc list-inside space-y-2 glass-muted ml-2">
        <li>
          <strong class="text-white/90">{gettext("Account data")}</strong>: {gettext(
            "your email address, first name and last name."
          )}
        </li>
        <li>
          <strong class="text-white/90">{gettext("GitHub sign-in data")}</strong>: {gettext(
            "if you sign in with GitHub, the profile information GitHub shares with us."
          )}
        </li>
        <li>
          <strong class="text-white/90">{gettext("Service credentials and tokens")}</strong>: {gettext(
            "the credentials or tokens needed to connect the external services you subscribe to. They are stored encrypted."
          )}
        </li>
        <li>
          <strong class="text-white/90">{gettext("Dashboard configuration")}</strong>: {gettext(
            "the services you subscribed to and the widgets you added and arranged."
          )}
        </li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("Why and how do we use your personal data?")}
      </h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "We use your data only to run the application. We do not use your data for advertising or profiling."
        )}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("When do we share your personal data?")}
      </h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "We do not sell your data. It is shared only when needed for the features you use: GitHub when you sign in with it."
        )}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("Cookies and tracking technologies")}
      </h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "Dashboard uses only the cookies required to work, such as the session cookie that keeps you signed in. We do not use advertising or analytics trackers."
        )}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("How long do we keep your personal data?")}
      </h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "Your data is kept as long as your account exists. When you delete your account from your profile page, your personal data and stored credentials are deleted as well."
        )}
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">
        {gettext("Your rights in relation to your personal data")}
      </h2>
      <p class="glass-muted leading-relaxed">
        {gettext(
          "Under the GDPR, you have the right to access, correct or delete your personal data, to object to its use, and to request a copy of it. To exercise these rights, contact us at"
        )}
        <a href="mailto:adrien.gregoire@epitech.eu" class="text-primary hover:underline">adrien.gregoire@epitech.eu</a>
        {gettext("or")} <a
          href="mailto:marc-antoine.sadio@epitech.eu"
          class="text-primary hover:underline"
        >marc-antoine.sadio@epitech.eu</a>.
      </p>
    </section>

    <div class="pt-6 text-center">
      <.link href={~p"/"} class="glass-button text-sm px-6">{gettext("Back to Dashboard")}</.link>
    </div>
  </div>
</.glass_page>
