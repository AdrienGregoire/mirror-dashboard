<%!--
## EPITECH PROJECT, 2026
## new.html.heex
## File description:
## Registration page
--%>

<.glass_page flash={@flash}>
  <.auth_card title="Create your account" subtitle="Dashboard Sport">
    <.form
      for={@form}
      id="registration-form"
      action={~p"/register"}
      method="post"
      class="space-y-6"
    >
      <.auth_input
        field={@form[:email]}
        type="email"
        label="Email"
        placeholder="name@exemple.com"
        autocomplete="email"
        required
        autofocus
      />
      <.auth_input
        field={@form[:password]}
        type="password"
        label="Password"
        placeholder="••••••••"
        hint="8 characters minimum"
        autocomplete="new-password"
        required
      />
      <button
        type="submit"
        class="glass-button w-full text-primary font-semibold text-lg py-3 mt-4"
      >
        <.icon name="hero-user-plus" class="w-5 h-5 mr-2" /> Create account
      </button>
    </.form>

    <.auth_divider>or</.auth_divider>
    <.oauth_button provider="github" label="Sign up with GitHub" />

    <:footer>
      Already have an account?
      <.link href={~p"/login"} class="text-primary font-semibold hover:underline ml-1">
        Log in
      </.link>
    </:footer>
  </.auth_card>
</.glass_page>
